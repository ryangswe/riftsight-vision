{
  "name": "cardvision-browser",
  "version": "0.1.0",
  "description": "Card detection and recognition for trading-card game video, in a web browser.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "build": "node scripts/build.mjs",
    "demo": "node scripts/build.mjs && node scripts/demo-server.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/pages-preview.mjs",
    "agreement": "node scripts/agreement.mjs",
    "test:webgpu": "node scripts/webgpu-test.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@webgpu/types": "0.1.74",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
